# Copy to .env and fill in. Never commit .env.
# Check it with:  python -m uv run --env-file .env python -m app.config

# --- Telegram (T-05) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# true = record outgoing messages in the DB but don't send them (used by the eval, T-37)
TELEGRAM_DRY_RUN=false

# --- You ---
OWNER_TIMEZONE=Asia/Kolkata
QUIET_START=23:00
QUIET_END=07:00

# --- Model (T-12). Any OpenAI-compatible endpoint; default OpenRouter free models ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
MODEL_MAIN=
# Empty = same as MODEL_MAIN
MODEL_BROWSER=
LLM_DAILY_REQUESTS=45
# Extra JSON merged into every request, e.g. {"reasoning": {"effort": "low"}}
LLM_EXTRA_JSON={}

# --- Storage ---
# Supabase -> Connect -> Session pooler (T-03)
DATABASE_URL=
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy in your password manager: without it, stored secrets can't be decrypted.
MASTER_KEY=
SECRETS_DB_PATH=/secrets/secrets.db

# --- Temporal (T-02) ---
TEMPORAL_ADDRESS=temporal:7233

# --- Google (T-19) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Browser live view (T-24 / T-25) ---
# VNC passwords are max 8 characters
VNC_PASSWORD=
LIVE_VIEW_URL=http://localhost:6080/vnc.html
# true only if MODEL_BROWSER accepts images (check with: scripts.llm_probe <model> --image)
BROWSER_VISION=false
# Set inside the browser container by docker-compose; change only for local experiments
# BROWSER_PROFILE_DIR=/profile
# BROWSER_CHANNEL=chrome
# BROWSER_HEADLESS=false

# --- Scheduling (T-33) ---
RECURRING_DO_MIN_MINUTES=60
